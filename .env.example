NODE_ENV=development
WEB_ORIGIN=http://localhost:5173,http://localhost:8080
API_PORT=8780
DATABASE_URL=postgres://cineweave:cineweave@localhost:5432/cineweave
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
APP_MASTER_KEY_BASE64=replace-with-openssl-rand-base64-32-output
